{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"ACTIVITY_RETENTION_ENABLED",
		"AUTH_SECRET",
		"BILLING_*",
		"COOKIE_DOMAIN",
		"CORS_ORIGINS",
		"CREEM_*",
		"CUSTOM_AUTH_*",
		"CUSTOM_OAUTH_*",
		"DATABASE_URL",
		"DEMO_MODE",
		"DEVICE_AUTH_CLIENT_IDS",
		"DISABLE_*",
		"DISCORD_CLIENT_ID",
		"DISCORD_CLIENT_SECRET",
		"ENABLE_*",
		"GITHUB_APP_ID",
		"GITHUB_APP_NAME",
		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"GITHUB_OAUTH_CLIENT_ID",
		"GITHUB_OAUTH_CLIENT_SECRET",
		"GITHUB_PRIVATE_KEY",
		"GITHUB_PRIVATE_KEY_BASE64",
		"GITHUB_WEBHOOK_SECRET",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"KANEO_*",
		"NOTIFICATION_SECRET_ENCRYPTION_KEY",
		"POSTGRES_*",
		"REDIS_*",
		"S3_*",
		"SENTRY_DSN",
		"SENTRY_ENVIRONMENT",
		"SENTRY_PROFILES_SAMPLE_RATE",
		"SENTRY_RELEASE",
		"SENTRY_TRACES_SAMPLE_RATE",
		"SMTP_*",
		"TRUSTED_PROXIES",
		"TURNSTILE_SECRET_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"@kaneo/site#build": {
			"outputs": [".next/**", "!.next/cache/**", "out/**"]
		},

		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"],
			"env": ["DATABASE_URL"]
		}
	}
}
